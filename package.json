{
  "name": "opravovna",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "npm run build && npm run start",
    "build": "node scripts/run-framework.mjs build",
    "start": "node scripts/start-local.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "dev:hot": "node scripts/run-framework.mjs dev",
    "test": "node --experimental-strip-types tests/api.mjs && node --experimental-strip-types tests/merge.mjs && node --experimental-strip-types tests/import-scores.mjs && node --experimental-strip-types tests/client-api.mjs && node tests/text-wrap.mjs && node tests/pdf-render.mjs && node tests/pdf-assets.mjs",
    "test:export": "node tests/export.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write app components hooks db lib deploy/runtime scripts tests",
    "format:check": "prettier --check app components hooks db lib deploy/runtime scripts tests",
    "check:size": "node scripts/check-source-size.mjs"
  },
  "dependencies": {
    "@clerk/localizations": "^4.23.0",
    "@clerk/nextjs": "^7.9.14",
    "@clerk/ui": "^1.40.0",
    "drizzle-orm": "0.45.2",
    "fabric": "^7.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "msgpackr": "^1.11.5",
    "next": "^16.3.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20261010.1",
    "@napi-rs/canvas": "^1.0.10",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.8",
    "json-rpc-2.0": "1.7.1",
    "prettier": "^3.9.10",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "^1.1.0",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "fflate": "0.8.3"
  }
}
